<%= layout("./layouts/boilerplate") %>
<body>

<style>
  /* ================== FILTER BASE (DESKTOP SAFE) ================== */
  #filters {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;        /* never wrap */
    overflow-x: auto;         /* scroll if overflow */
    white-space: nowrap;
  }

  #filters::-webkit-scrollbar {
    display: none;
  }

  .filter {
    text-align: center;
    margin-right: 2rem;
    margin-top: 2rem;
    opacity: 0.7;
    transition: all 0.2s ease;
    pointer-events: auto;
  }

  .filter p {
    font-size: 0.8rem;
    margin: 0;
  }

  /* ✅ CORRECT HOVER (IMPORTANT FIX) */
  /* ✅ WORKING HOVER (overflow-safe) */
.filter:hover {
  opacity: 1;
  transform: translateY(-2px);
  cursor: pointer;
}

#filters a:hover .filter {
  opacity: 1;
  transform: translateY(-2px);
  background-color: rgba(0, 0, 0, 0.05);
  border-radius: 10px;
}

.filter:hover i,
.filter:hover p {
  color: #000 !important;
}

  /* ================== FILTER WRAPPER + ARROWS ================== */
  .filters-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .filter-arrow {
    display: none;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    background: #fff;
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    cursor: pointer;
    z-index: 20;
    align-items: center;
    justify-content: center;
  }

  .filter-arrow.left {
    left: 6px;
  }

  .filter-arrow.right {
    right: 6px;
  }

  /* ================== MOBILE ONLY ================== */
  @media (max-width: 768px) {

    #filters {
      padding: 0.5rem 3rem;   /* space for arrows */
    }

    .filter {
      margin: 0;
      min-width: 72px;
      flex-shrink: 0;
    }

    .filter p {
      font-size: 0.75rem;
    }

    .filter-arrow {
      display: flex;
    }

    /* smaller listing cards */
    .listing-card img {
      height: 14rem !important;
      object-fit: cover;
    }

    .card-body {
      padding: 0.6rem;
    }

    .card-text {
      font-size: 0.9rem;
    }

    /* ONLY mobile: 2 cards per row */
    .row-cols-sm-1 > * {
      flex: 0 0 50%;
      max-width: 50%;
    }
  }

  /* hide arrows on desktop unless needed */
  @media (min-width: 769px) {
    .filter-arrow {
      display: none;
    }
  }

  /* ================== LISTING HOVER (FADE / BLUR) ================== */
.listing-link {
  text-decoration: none;
  color: inherit;
}

/* desktop hover */
.listing-link:hover .listing-card {
  opacity: .7;          /* subtle fade */
      /* light blur */
}
</style>

<!-- ================== FILTERS WITH MOBILE ARROWS ================== -->
<div class="filters-wrapper">

  <!-- Mobile left arrow -->
  <button class="filter-arrow left" id="filterLeft">
    <i class="fa-solid fa-chevron-left"></i>
  </button>

  <div id="filters">

    <a href="/listings" class="text-decoration-none text-dark">
      <div class="filter">
        <i class="fa-solid fa-list"></i>
        <p>All</p>
      </div>
    </a>

    <a href="/listings?category=rooms" class="text-decoration-none text-dark">
      <div class="filter">
        <i class="fa-solid fa-bed"></i>
        <p>Rooms</p>
      </div>
    </a>

    <a href="/listings?category=cities" class="text-decoration-none text-dark">
      <div class="filter">
        <i class="fa-solid fa-mountain-city"></i>
        <p>Iconic Cities</p>
      </div>
    </a>

    <a href="/listings?category=mountain" class="text-decoration-none text-dark">
      <div class="filter">
        <i class="fa-solid fa-mountain"></i>
        <p>Mountains</p>
      </div>
    </a>

    <a href="/listings?category=castle" class="text-decoration-none text-dark">
      <div class="filter">
        <i class="fa-brands fa-fort-awesome"></i>
        <p>Castles</p>
      </div>
    </a>

    <a href="/listings?category=pool" class="text-decoration-none text-dark">
      <div class="filter">
        <i class="fa-solid fa-person-swimming"></i>
        <p>Amazing Pools</p>
      </div>
    </a>

    <a href="/listings?category=camping" class="text-decoration-none text-dark">
      <div class="filter">
        <i class="fa-solid fa-campground"></i>
        <p>Camping</p>
      </div>
    </a>

    <a href="/listings?category=farm" class="text-decoration-none text-dark">
      <div class="filter">
        <i class="fa-solid fa-cow"></i>
        <p>Farm</p>
      </div>
    </a>

    <a href="/listings?category=arctic" class="text-decoration-none text-dark">
      <div class="filter">
        <i class="fa-solid fa-snowflake"></i>
        <p>Arctic</p>
      </div>
    </a>

    <a href="/listings?category=dome" class="text-decoration-none text-dark">
      <div class="filter">
        <i class="fa-solid fa-igloo"></i>
        <p>Domes</p>
      </div>
    </a>

    <a href="/listings?category=boat" class="text-decoration-none text-dark">
      <div class="filter">
        <i class="fa-solid fa-ship"></i>
        <p>Boats</p>
      </div>
    </a>
  </div>

  <!-- Mobile right arrow -->
  <button class="filter-arrow right" id="filterRight">
    <i class="fa-solid fa-chevron-right"></i>
  </button>

</div>

<!-- ================== LISTINGS ================== -->
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
  <% for (let listing of allListing) { %>
    <a href="/listings/<%= listing._id %>" class="listing-link">
      <div class="card col listing-card">
        <img src="<%= listing.image.url %>" class="card-img-top" style="height: 20rem;">
        <div class="card-body">
          <p class="card-text">
            <b><%= listing.title %></b><br>
            &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
          </p>
        </div>
      </div>
    </a>
  <% } %>
</div>

<script>
  const filters = document.getElementById("filters");
  const leftBtn = document.getElementById("filterLeft");
  const rightBtn = document.getElementById("filterRight");

  const scrollAmount = 200;

  // show arrows only when overflow exists
  function toggleArrows() {
    const canScroll = filters.scrollWidth > filters.clientWidth;
    leftBtn.style.display = canScroll ? "flex" : "none";
    rightBtn.style.display = canScroll ? "flex" : "none";
  }

  toggleArrows();
  window.addEventListener("resize", toggleArrows);

  // looping scroll
  rightBtn.addEventListener("click", () => {
    const maxScroll = filters.scrollWidth - filters.clientWidth;

    if (filters.scrollLeft >= maxScroll - 5) {
      filters.scrollTo({ left: 0, behavior: "smooth" });
    } else {
      filters.scrollBy({ left: scrollAmount, behavior: "smooth" });
    }
  });

  leftBtn.addEventListener("click", () => {
    const maxScroll = filters.scrollWidth - filters.clientWidth;

    if (filters.scrollLeft <= 5) {
      filters.scrollTo({ left: maxScroll, behavior: "smooth" });
    } else {
      filters.scrollBy({ left: -scrollAmount, behavior: "smooth" });
    }
  });
</script>

</body>
