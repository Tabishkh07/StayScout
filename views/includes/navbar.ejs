<style>
  .search-btn { 
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0.4rem 1rem;
    white-space: nowrap;
  }
  .search-btn:hover { 
    background-color: #fe424d;
    color: #fff;
  }
  .search-btn i {
    margin-right: 0.4rem;
  }
  .search-inp {
    border-radius: 25px;
    padding: 0.45rem 1rem; /* 🔥 reduced for mobile */
    font-size: 0.95rem;
  }
  /* ✅ MOBILE & TABLET FIXES (NO HTML CHANGE) */
  @media (max-width: 768px) {
    /* stack navbar items */
    .navbar-collapse {
      text-align: center;
    }
    /* search form full width */
    .navbar-nav form {
      flex-direction: column;
      width: 100%;
    }
    .search-inp {
      width: 100%;
      margin-bottom: 0.5rem;
    }
    .search-btn {
      width: 100%;
    }
    /* spacing between nav sections */
    .navbar-nav {
      margin-top: 0.75rem;
    }
  }
</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings">
      <i class="fa-regular fa-compass"></i>
    </a>

    <button class="navbar-toggler" 
            type="button" 
            data-bs-toggle="collapse" 
            data-bs-target="#navbarNavAltMarkup">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">

      <div class="navbar-nav">
        <a class="nav-link" href="/listings">StayScout</a>
      </div>

      <!-- search -->
      <div class="navbar-nav ms-auto">
        <form class="d-flex" role="search" action="/listings" method="GET">
          <input
            class="form-control me-2 search-inp"
            type="search"
            placeholder="Search Destination"
            name="q"
            aria-label="Search"
          />
          <button class="btn search-btn" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>
            Search
          </button>
        </form>
      </div>

      <!-- for signup -->
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">Add Property</a>

        <% if (!currUser) { %>
          <a class="nav-link" href="/signup"><b>Sign Up</b></a>
          <a class="nav-link" href="/login"><b>Log in</b></a>
        <% } %>

        <% if (currUser) { %>
          <a class="nav-link" href="/logout"><b>Log out</b></a>
        <% } %>
      </div>

    </div>
  </div>
</nav>
