<style>
  /* ================== COMMON ================== */
  .search-btn { 
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0 1rem;
    display: flex;
    align-items: center;
    white-space: nowrap;
  }

  .search-btn i {
    margin-right: 0.5rem;
  }

  .search-inp {
    border-radius: 25px;
    padding: 0.5rem 1rem;
    font-size: 1rem;
    flex: 1;
    min-width: 0;
  }

  /* ================== MOBILE + TABLET ================== */
  @media (max-width: 991.98px) {

    .desktop-only,
    .navbar-toggler {
      display: none !important;
    }

    /* 🔥 MOBILE LOGO + SEARCH ROW */
    .mobile-top-row {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      width: 100%;
      padding: 0.6rem;
    }

    .mobile-logo {
      font-size: 1.5rem;
      color: #fe424d;
      text-decoration: none;
      flex-shrink: 0;
      display: flex;
      align-items: center;
    }

    .mobile-search-only {
      flex: 1;
    }

    .mobile-search-only form {
      display: flex;
      width: 100%;
      gap: 0.5rem;
    }

    .mobile-search-only .search-inp {
      font-size: 0.95rem;
    }

    .mobile-footer {
      display: flex !important;
    }

    body {
      padding-bottom: 55px;
    }
  }

  /* ================== DESKTOP ================== */
  @media (min-width: 992px) {
    .mobile-top-row,
    .mobile-footer {
      display: none !important;
    }

    body {
      padding-bottom: 0;
    }
  }

  /* ================== MOBILE FOOTER ================== */
  .mobile-footer {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 56px;
    background: #fff;
    z-index: 1050;
    justify-content: space-around;
    align-items: center;
    box-shadow: 0 -1px 6px rgba(0,0,0,0.08);
  }

  .mobile-footer a {
    color: #222;
    font-size: 0.9rem;
  }
</style>

<nav class="navbar navbar-expand-lg bg-body-light border-bottom sticky-top">
  <div class="container-fluid">

    <!-- ================== DESKTOP LOGO ================== -->
    <a class="navbar-brand desktop-only" href="/listings">
      <i class="fa-regular fa-compass"></i>
    </a>

    <!-- ================== MOBILE LOGO + SEARCH ================== -->
    <div class="mobile-top-row">

      <!-- MOBILE LOGO -->
      <a href="/listings" class="mobile-logo">
        <i class="fa-regular fa-compass"></i>
      </a>

      <!-- MOBILE SEARCH -->
      <div class="mobile-search-only">
        <form action="/listings" method="GET">
          <input
            class="form-control search-inp"
            type="search"
            placeholder="Search Destination"
            name="q"
            style="border: 2px solid rgb(201, 201, 201);"
          />
          <button class="btn search-btn" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>
            Search
          </button>
        </form>
      </div>

    </div>

    <!-- ================== DESKTOP NAV ================== -->
    <div class="collapse navbar-collapse">
      <div class="navbar-nav ms-auto desktop-only">
        <a class="nav-link" href="/listings">StayScout</a>
        <a class="nav-link" href="/listings/new">Add Property</a>

        <% if (!currUser) { %>
          <a class="nav-link" href="/signup"><b>Sign Up</b></a>
          <a class="nav-link" href="/login"><b>Log in</b></a>
        <% } %>

        <% if (currUser) { %>
          <a class="nav-link" href="/logout"><b>Log out</b></a>
        <% } %>
      </div>
    </div>

  </div>
</nav>

<!-- ================== MOBILE BOTTOM FOOTER ================== -->
<div class="mobile-footer border-top">
  <% if (!currUser) { %>
    <a href="/signup" class="text-decoration-none fw-bold">Sign up</a>
    <a href="/login" class="text-decoration-none fw-bold">Log in</a>
  <% } %>

  <% if (currUser) { %>
    <a href="/logout" class="text-decoration-none fw-bold">Log out</a>
  <% } %>
</div>
