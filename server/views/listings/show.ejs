<%= layout("./layouts/boilerplate") %>

<div class="row mt-4">

  <div class="col-8 offset-2">
    <h3>List Details:</h3>
  </div>

  <!-- Listing Card -->
  <div class="col-8 offset-2 mt-3">
    <div class="card">

      <!-- Image with fallback -->
      <img 
        src="<%= listing.image && listing.image.url && listing.image.url.trim() !== '' 
              ? listing.image.url 
              : 'https://images.unsplash.com/photo-1625505826533-5c80aca7d157' %>"
        class="card-img-top show-img"
        alt="listing_img">

      <div class="card-body">
        <h5 class="card-title"><%= listing.title %></h5>

        <p class="card-text">
          <%= listing.description %>
        </p>

        <p class="card-text">
          <strong>₹ <%= listing.price.toLocaleString("en-IN") %></strong><br>
          <%= listing.location %>, <%= listing.country %>
        </p>

        <!-- Action Buttons -->
        <div class="d-flex gap-2 mt-3">

          <a href="/listings/<%= listing._id %>/edit" class="btn edit-btn">
            Edit
          </a>

          <form action="/listings/<%= listing._id %>?_method=delete" method="post">
            <button class="btn btn-dark">
              Delete
            </button>
          </form>

        </div>
      </div>

    </div>
  </div>

</div>
