<%= layout("./layouts/boilerplate") %>

<div class="row mt-4">

  <div class="col-8 offset-2">
    <h3><%= listing.title %></h3>
  </div>

  <div class="col-8 offset-2 mt-3">
    <div class="card listing-card show-card">

      <img 
        src="<%= listing.image && listing.image.url && listing.image.url.trim() !== '' 
          ? listing.image.url 
          : 'https://images.unsplash.com/photo-1625505826533-5c80aca7d157?auto=format&fit=crop&w=800&q=60' %>"
        class="card-img-top show-img"
        alt="listing image">

      <div class="card-body">

        <p class="card-text">
          <%= listing.description %>
        </p>

        <p class="card-text">
          <strong>₹ <%= listing.price.toLocaleString("en-IN") %></strong><br>
          <%= listing.location %>, <%= listing.country %>
        </p>

        <div class="d-flex gap-2 mt-3">
          <a href="/listings/<%= listing._id %>/edit" class="btn edit-btn">
            Edit
          </a>

          <form action="/listings/<%= listing._id %>?_method=DELETE" method="post">
            <button class="btn btn-dark">Delete</button>
          </form>
        </div>
        <div class="mb-3">
          <hr>
          <h4>Leave a Review</h4>
          <form action="/listings/<%= listing.id%>/reviews" method="post" novalidate class="needs-validation">
            <div class="mb-3 mt-3">
              <label for="rating" class="form-label">Rating</label>
              <input type="range" name="review[rating]" id="rating" min="1" max="5" class="form-range" >
            </div>
            <div class="mb-3 mt-3">
              <label for="comment" class="form-label">Comment</label>
              <textarea name="review[comment]" 
                id="comment" cols="30" 
                rows="5" class="form-control" required></textarea>
                <div class="valid-feedback">Comment looks good</div>
                <div class="invalid-feedback">Please add some comments for review</div>
            </div>
            <button class="btn btn-outline-dark">Submit</button>
          </form>
        </div>

        <hr>
        
        <p><b>All Reviews</b></p>
        <div class="row">
          <% for(review of listing.reviews){ %>
        <div class="card col-5 ms-3 mb-3">
          <div class="card-body mt-3">
            <h5 class="card-title">John Dos</h5>
            <p class="card-review"><%= review.comment %></p>
            <p class="card-review"><%= review.rating %> stars</p>
          </div>
          <form class="mb-3" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=delete">
            <button class="btn btn-sm btn-dark">Delete</button>
          </form>
        </div>
        <% } %>
        </div>
        
      </div>
    </div>
  </div>
</div>
