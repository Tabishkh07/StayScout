<%=layout("./layouts/boilerplate")  %>

<div class="row mt-3">
    <h1 class="col-6 offset-3">SignUp on StayScout</h1>
    <div class="col-6 offset-3 mt-3">
        <form action="/signup" method="post" class="needs-validation" novalidate>
            <!-- username -->
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input type="text" name="username" id="username" placeholder="abs123" class="form-control" required>
                <div class="valid-feedback">Looks good!</div>
                <div class="invalid-feedback">username is mandatory</div>
            </div>

            <!-- email -->
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" name="email" id="email" placeholder="abs123@gmail.com" class="form-control" required>
            </div>

            <!-- password -->
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input type="password" name="password" id="password" placeholder="*****" class="form-control" required>
            </div>
            <button class="btn btn-success">SignUp</button>
        </form>
    </div>
</div>
